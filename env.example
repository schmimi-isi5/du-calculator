# Copy this file to .env at the repo root before running `docker compose up`.
# docker compose automatically reads a .env file next to docker-compose.yml.
# In Coolify, set these as environment variables in the app's UI instead -
# a root .env is only needed for local `docker compose` usage.

# Postgres
POSTGRES_USER=du_calculator
POSTGRES_PASSWORD=change_me
POSTGRES_DB=du_calculator

# AI Provider (interim: Anthropic; see backend/src/ai/getAIProvider.ts)
ANTHROPIC_API_KEY=

# Pricing (EUR per Development Unit)
PRICE_PER_DU=300

# Git operations
GIT_CLONE_TIMEOUT_MS=60000
GIT_MAX_REPO_FILES=5000

# Public port the frontend (nginx) is exposed on
FRONTEND_PORT=8080
