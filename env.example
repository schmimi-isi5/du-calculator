# Copy this file to .env at the repo root before running `docker compose up`.
# docker compose automatically reads a .env file next to docker-compose.yml.
# In Coolify, set these as environment variables in the app's UI instead -
# a root .env is only needed for local `docker compose` usage.

# Postgres
POSTGRES_USER=du_calculator
POSTGRES_PASSWORD=change_me
POSTGRES_DB=du_calculator

# AI Provider - which implementation is active (see backend/src/ai/getAIProvider.ts)
# One of: anthropic (default) | openai | openrouter | local
AI_PROVIDER=anthropic
# Optional for anthropic (defaults to claude-opus-5); required for every other provider.
AI_MODEL=
# Override the endpoint - needed for openrouter/local, optional for openai.
AI_BASE_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LOCAL_AI_API_KEY=

# Only used for openrouter/local models this app has no fixed price for
# (see backend/src/ai/pricing.ts) - without these, such calls are logged
# with cost "unknown" rather than a guessed number.
AI_CUSTOM_INPUT_PRICE_PER_MTOK=
AI_CUSTOM_OUTPUT_PRICE_PER_MTOK=

# --- Multi-LLM Model Registry (see backend/src/domain/models.ts) ------------
# Independent of AI_PROVIDER above - each of these is one more provider a
# user can pick per requirement in the UI. A provider with no key set here
# simply has no available models in the picker.
DEEPSEEK_API_KEY=
GOOGLE_AI_API_KEY=
QWEN_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenRouter is a gateway to hundreds of upstream models - list exactly the
# model slugs you want selectable (comma-separated). Uses the same
# OPENROUTER_API_KEY already declared above.
# OPENROUTER_MODELS=anthropic/claude-3.7-sonnet,mistralai/mixtral-8x22b-instruct,deepseek/deepseek-r1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama server - no API key needed. Never hard-code this address.
OLLAMA_BASE_URL=http://localhost:11434

# The model a requirement falls back to when none is explicitly chosen.
# Leave unset to use the built-in fallback chain (DeepSeek V4.1 Flash ->
# GPT-5.6 Luna -> Gemini 3.8 Flash -> local Qwen).
DEFAULT_LLM_MODEL=

# Set to "true" to allow GPT-6 Astra / Claude Fable 5 / Claude Opus 5 to be
# picked automatically as a default- or Auto-mode fallback.
LLM_ALLOW_PREMIUM_FALLBACK=

# Pricing (EUR per Development Unit)
PRICE_PER_DU=300

# Git operations
GIT_CLONE_TIMEOUT_MS=60000
GIT_MAX_REPO_FILES=5000

# Public port the frontend (nginx) is exposed on
FRONTEND_PORT=8080
