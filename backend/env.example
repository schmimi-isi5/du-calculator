# Copy this file to .env and fill in the values.
#
# Server
PORT=4000

# AI Provider - which implementation is active (see src/ai/getAIProvider.ts)
# One of: anthropic (default) | openai | openrouter | local
AI_PROVIDER=anthropic
# Optional for anthropic (defaults to claude-opus-5); required for every other provider.
AI_MODEL=
# Override the endpoint - needed for openrouter/local, optional for openai.
AI_BASE_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Most local OpenAI-compatible servers (e.g. Ollama) ignore the key - leave blank.
LOCAL_AI_API_KEY=

# Only used for openrouter/local models this app has no fixed price for
# (see src/ai/pricing.ts) - without these, calls to such a model are logged
# with cost "unknown" rather than a guessed number.
AI_CUSTOM_INPUT_PRICE_PER_MTOK=
AI_CUSTOM_OUTPUT_PRICE_PER_MTOK=

# Pricing (EUR per Development Unit)
PRICE_PER_DU=300

# Git operations
GIT_CLONE_TIMEOUT_MS=60000
GIT_MAX_REPO_FILES=5000
