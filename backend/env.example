# Copy this file to .env and fill in the values.
#
# Server
PORT=4000

# AI Provider - which implementation is active (see src/ai/getAIProvider.ts)
# One of: anthropic (default) | openai | openrouter | local
AI_PROVIDER=anthropic
# Optional for anthropic (defaults to claude-opus-5); required for every other provider.
AI_MODEL=
# Override the endpoint - needed for openrouter/local, optional for openai.
AI_BASE_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Most local OpenAI-compatible servers (e.g. Ollama) ignore the key - leave blank.
LOCAL_AI_API_KEY=

# Only used for openrouter/local models this app has no fixed price for
# (see src/ai/pricing.ts) - without these, calls to such a model are logged
# with cost "unknown" rather than a guessed number.
AI_CUSTOM_INPUT_PRICE_PER_MTOK=
AI_CUSTOM_OUTPUT_PRICE_PER_MTOK=

# --- Multi-LLM Model Registry (see src/domain/models.ts) ---------------------
# Independent of AI_PROVIDER above: each of these is one more provider a
# user can pick per requirement (see the model picker in the UI), not a
# replacement for it. A provider with no key set here simply has no
# available models in the picker - nothing else breaks.
DEEPSEEK_API_KEY=
GOOGLE_AI_API_KEY=
QWEN_API_KEY=
# Overrides only needed for a non-default region/deployment.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Local Ollama server - no API key needed. Never hard-code this address.
OLLAMA_BASE_URL=http://localhost:11434

# The model a requirement falls back to when none is explicitly chosen (see
# domain/models.ts resolveDefaultModel). Leave unset to use the built-in
# fallback chain (DeepSeek V4.1 Flash -> GPT-5.6 Luna -> Gemini 3.8 Flash ->
# local Qwen).
DEFAULT_LLM_MODEL=

# Set to "true" to allow GPT-6 Astra / Claude Fable 5 / Claude Opus 5 to be
# picked automatically as a default- or Auto-mode fallback. Off by default -
# an operator opts in before an expensive model is ever chosen silently.
LLM_ALLOW_PREMIUM_FALLBACK=

# Pricing (EUR per Development Unit)
PRICE_PER_DU=300

# Git operations
GIT_CLONE_TIMEOUT_MS=60000
GIT_MAX_REPO_FILES=5000
